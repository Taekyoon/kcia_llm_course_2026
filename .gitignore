# =====================================================================
# 이 repo 는 VESSL 에서 실습을 돌리기 위한 것이다.
# 강의 저작물과 발주처 문서는 **의도적으로 제외**한다.
# private repo 라도 굳이 올릴 이유가 없고, 실수로 공개 전환될 여지를 줄인다.
# =====================================================================

# --- 발주처 문서 · 강의 저작물 (절대 커밋하지 않음) ---
*.hwp
*.hwpx
ppt/
work/ppt/

# --- 내부 검토 산출물 (로컬 보관) ---
review/
extracted/

# Claude 작업 규칙. review/ · extracted/ 를 참조하는데 그 둘이 여기 없어서 제외한다.
# 로컬에서만 쓴다. repo 에도 두고 싶으면 이 줄을 지우면 된다.
CLAUDE.md

# --- 도구 출력 · 캐시 ---
tools/.venv/
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.uv/

# --- 실습 실행 중 생기는 것 ---
# ⚠️ data/ 와 assets/ 를 혼동하지 말 것.
#      data/    실행하면 생기는 것. 여기 있는 건 언제든 다시 만들 수 있다. (무시)
#      assets/  강사가 미리 만들어 배포하는 것. 수업 중에 못 만든다. (커밋)
#    사전생성 데이터셋을 data/ 에 두면 아래 한 줄에 조용히 먹힌다.
data/
model/
outputs/
runs/
*.log
nsmc_classifier/
ner_seq_classifier/
bm25_retriever/
amazon_gpt_summary.csv
wandb/

